# OpenRouter (LLM backend for the ReAct agent and propose_variants)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# BioLM (real MCP server, spawned as a Node subprocess via npx)
BIOLMAI_TOKEN=

# UniProt REST API (free, keyless - no token needed)
UNIPROT_BASE_URL=https://rest.uniprot.org

# ProTrek local FastAPI (optional). When set, search_protrek is registered.
# Example: http://127.0.0.1:8090
PROTREK_BASE_URL=

# Search / generation defaults
DEFAULT_RESULT_SIZE=5
SESSION_TTL_SECONDS=3600

# Eval mode: 0 = use recorded fixtures (offline), 1 = hit real UniProt/BioLM
EVAL_LIVE=0
